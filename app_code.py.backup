                    'agent': row[0],
                    'question': row[1],
                    'answer': row[2],
                    'times_used': row[3],
                    'learned_at': row[4].strftime('%Y-%m-%d %H:%M') if row[4] else ''
                })
        
        return jsonify({'success': True, 'knowledge': knowledge})
        
