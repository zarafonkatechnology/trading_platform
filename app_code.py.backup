                    }
                    document.getElementById('mistakesContainer').innerHTML = html || '<p>No mistakes recorded yet</p>';
                }
                
                // Load lessons
                const lessonsRes = await fetch('/api/learning/lessons');
                const lessonsData = await lessonsRes.json();
                
                if (lessonsData.success) {
