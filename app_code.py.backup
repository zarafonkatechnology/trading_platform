                FROM agent_knowledge 
                WHERE agent_name = %s
                ORDER BY times_used DESC LIMIT 20
            """, (agent_name,))
        else:
            cur.execute("""
                SELECT agent_name, question, answer, times_used, created_at 
                FROM agent_knowledge 
                ORDER BY times_used DESC LIMIT 30
            """)
        
