// INITIALIZE DASHBOARD
// ============================================================

document.addEventListener('DOMContentLoaded', function() {
    const token = localStorage.getItem('client_token');
    const clientData = JSON.parse(localStorage.getItem('client_data') || '{}');
    const accountId = clientData.id || clientData.account_id || 'client_' + Date.now();
    
    if (!token) {
        window.location.href = '/client_login.html';
        return;
    }
    
    // Create dashboard instance
    window.dashboard = new ClientDashboard(accountId, token);
    
    // Make it globally accessible
    window.dashboardInstance = window.dashboard;
    
    console.log('✅ Dashboard initialized with WebSocket');
});
