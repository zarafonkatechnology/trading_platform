// Load cards when page loads
document.addEventListener('DOMContentLoaded', function() {
    console.log('🔄 Initializing card management...');
    loadCardsFromAPI();
    
    // Close modal when clicking outside
    const modal = document.getElementById('addCardModal');
    if (modal) {
        modal.addEventListener('click', function(e) {
            if (e.target === this) {
                closeAddCardForm();
            }
        });
    }
    
    // Close with ESC key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeAddCardForm();
        }
    });
    
    // Preview card holder name in real-time
    const holderInput = document.getElementById('cardHolderName');
    if (holderInput) {
        holderInput.addEventListener('input', function() {
            const preview = document.getElementById('previewCardHolder');
            if (preview) {
                preview.textContent = this.value.toUpperCase() || 'CARD HOLDER';
            }
        });
    }
    
    console.log('✅ Card management initialized');
});
