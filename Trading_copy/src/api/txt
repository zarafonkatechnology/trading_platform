let isPageLoaded = false;

document.addEventListener('DOMContentLoaded', function() {
    if (isPageLoaded) return;
    isPageLoaded = true;
    
    console.log('🚀 Page loaded, initializing...');
    
    // ✅ Load only what's visible first
    loadClientData();
    loadLivePrices();
    
    // ✅ Load other data after 1 second (non-blocking)
    setTimeout(() => {
        loadPositions();
        loadSignals();
        loadHistory();
    }, 1000);
    
    // ✅ Initialize WebSocket after 2 seconds
    setTimeout(() => {
        if (typeof connectWebSocket === 'function') {
            connectWebSocket();
        }
    }, 2000);
    
    // ✅ Initialize chart on demand (when trading page is clicked)
    const tradingNav = document.querySelector('[data-page="trading"]');
    if (tradingNav) {
        tradingNav.addEventListener('click', function() {
            setTimeout(() => {
                if (!chartReady) {
                    initMT4Chart();
                }
            }, 300);
        });
    }
    
    // ✅ Start refresh intervals
    updateTimeDisplay();
    setInterval(updateTimeDisplay, 1000);
    
    // ✅ Price updates every 500ms
    setInterval(() => {
        if (document.getElementById('priceTicker')) {
            loadLivePrices();
        }
    }, 500);
    
    // ✅ Positions every 15 seconds
    setInterval(() => {
        if (document.getElementById('positionsList')) {
            loadPositions();
        }
    }, 15000);
    
    // ✅ Signals every 60 seconds
    setInterval(() => {
        if (document.getElementById('signalsList')) {
            loadSignals();
        }
    }, 60000);
    
    console.log('✅ Dashboard initialized');
});
