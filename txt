# 1. SIMPLE 1-HOUR TREND FILTER
# ============================================================

class SimpleHourlyTrendFilter:
    """Simple 1-hour trend check - ONLY 30 LINES"""
    
    def __init__(self, lookback=20):
        self.lookback = lookback
        self.price_history = {}
    
    def update_price(self, symbol: str, price: float):
        if symbol not in self.price_history:
            self.price_history[symbol] = deque(maxlen=self.lookback)
        self.price_history[symbol].append(price)
    
    def check_trend(self, symbol: str, action: str) -> Dict:
        """Simple trend check: compare current to 4 bars ago (1 hour on 15-min)"""
        if symbol not in self.price_history or len(self.price_history[symbol]) < 5:
            return {'allowed': True, 'message': 'Building 1H history'}
        
        prices = list(self.price_history[symbol])
        current = prices[-1]
        one_hour_ago = prices[-4] if len(prices) >= 4 else prices[0]
        
        # 0.15% threshold for trend direction
        if action == 'BUY':
            if current < one_hour_ago * 0.9985:
                return {'allowed': False, 'message': '1H downtrend, no BUY'}
            return {'allowed': True, 'message': '1H supports BUY'}
        elif action == 'SELL':
            if current > one_hour_ago * 1.0015:
                return {'allowed': False, 'message': '1H uptrend, no SELL'}
            return {'allowed': True, 'message': '1H supports SELL'}
        
        return {'allowed': True, 'message': 'No action'}


