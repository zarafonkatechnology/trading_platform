# 3. Z-SCORE ENGINE
# ============================================================

class ZScoreEngine:
    """Z-Score Engine with symbol-specific thresholds"""
    
    def __init__(self, lookback: int = 50):
        self.lookback = lookback
        self.price_history = {}
        self.mean = {}
        self.std = {}
        self.z_score = {}
        self.samples = {}
        
        self.thresholds = {
            '#NASDAQ100': {'entry': 2.7}, '#DJ30': {'entry': 2.5}, '#S&P500': {'entry': 2.5},
            '#RUSS2000': {'entry': 2.7}, '#CAC40': {'entry': 2.2}, '#DAX40': {'entry': 2.2},
            '#FTSE100': {'entry': 2.2}, '#NIKKEI225': {'entry': 2.2},
            'GOLD': {'entry': 2.0}, 'SILVER': {'entry': 2.0},
            'BRENT_OIL': {'entry': 2.0}, 'CrudeOIL': {'entry': 2.0},
            'EURUSD': {'entry': 1.8}, 'GBPUSD': {'entry': 1.8}, 'USDJPY': {'entry': 1.8},
            'USDCHF': {'entry': 1.6}, 'AUDUSD': {'entry': 1.8}, 'USDCAD': {'entry': 1.8},
            'NZDUSD': {'entry': 1.8}, 'EURGBP': {'entry': 1.6}, 'EURJPY': {'entry': 1.6},
            'EURCAD': {'entry': 1.6}, 'EURNZD': {'entry': 1.6}, 'EURCHF': {'entry': 1.6},
            '#DOLLAR_IND': {'entry': 2.0}
        }
    
    def get_threshold(self, symbol: str) -> float:
        return self.thresholds.get(symbol, {}).get('entry', 2.0)
    
    def update_price(self, symbol: str, price: float):
        if symbol not in self.price_history:
            self.price_history[symbol] = deque(maxlen=self.lookback)
        self.price_history[symbol].append(price)
        self.samples[symbol] = len(self.price_history[symbol])
    
    def calculate_zscore(self, symbol: str, price: float) -> Dict:
        self.update_price(symbol, price)
        
        if self.samples.get(symbol, 0) < 20:
            return {
                'z_score': 0,
                'action': 'HOLD',
                'confidence': 0,
                'samples': self.samples.get(symbol, 0),
                'reasoning': f'Building history: {self.samples.get(symbol, 0)}/20'
            }
        
        history = list(self.price_history[symbol])
        self.mean[symbol] = sum(history) / len(history)
        variance = sum((x - self.mean[symbol]) ** 2 for x in history) / len(history)
        self.std[symbol] = math.sqrt(variance) if variance > 0 else 0.0001
        
        if self.std[symbol] > 0:
            z_score = (price - self.mean[symbol]) / self.std[symbol]
            self.z_score[symbol] = z_score
        else:
            z_score = 0
        
        entry_threshold = self.get_threshold(symbol)
        
        if z_score > entry_threshold:
            return {
                'z_score': z_score,
                'action': 'SELL',
                'confidence': min(95, 75 + (z_score - entry_threshold) * 15),
                'mean': self.mean[symbol],
                'std': self.std[symbol],
                'samples': self.samples.get(symbol, 0),
                'reasoning': f'Overbought: Z={z_score:.2f}'
            }
        elif z_score < -entry_threshold:
            return {
                'z_score': z_score,
                'action': 'BUY',
                'confidence': min(95, 75 + (-z_score - entry_threshold) * 15),
                'mean': self.mean[symbol],
                'std': self.std[symbol],
                'samples': self.samples.get(symbol, 0),
                'reasoning': f'Oversold: Z={z_score:.2f}'
            }
        else:
            return {
                'z_score': z_score,
                'action': 'HOLD',
                'confidence': max(40, 50 - abs(z_score) * 5),
                'mean': self.mean[symbol],
                'std': self.std[symbol],
                'samples': self.samples.get(symbol, 0),
                'reasoning': f'Normal: Z={z_score:.2f}'
            }


