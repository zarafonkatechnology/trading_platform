    def execute_trade(self, symbol: str, signal: Dict) -> Dict:
        """Execute real trade in MT4"""
        action = signal.get('action', 'HOLD')
        confidence = signal.get('confidence', 0)
        price = signal.get('price', 0)
        zscore = signal.get('zscore', {}).get('z_score', 0)
        reasoning = signal.get('reasoning', '')
        
        # Check if already have position
        if symbol in self.active_positions:
            return {'status': 'SKIPPED', 'reason': f'Already have position in {symbol}'}
        
        # Check risk limits
        allowed, reason = self.risk_manager.check_trade_allowed(symbol)
        if not allowed:
            return {'status': 'BLOCKED', 'reason': reason}
        
        # Get symbol config
        config = self.get_symbol_config(symbol)
        pip = config.get('pip', 0.0001)
        digits = config.get('digits', 5)
        sl_pips = config.get('sl_pips', 20)
        tp_pips = config.get('tp_pips', 40)
        volume = config.get('volume', 0.01)
        
        # Calculate SL and TP
        if action == 'BUY':
            sl = price - (sl_pips * pip)
            tp = price + (tp_pips * pip)
        else:  # SELL
            sl = price + (sl_pips * pip)
            tp = price - (tp_pips * pip)
        
        # Round values
        price = round(price, digits)
        sl = round(sl, digits)
        tp = round(tp, digits)
        
        # Log trade
        logger.info(f'\n📊 EXECUTING REAL TRADE:')
        logger.info(f'   Symbol: {symbol}')
        logger.info(f'   Action: {action}')
        logger.info(f'   Price: {price}')
        logger.info(f'   Volume: {volume}')
        logger.info(f'   SL: {sl}')
        logger.info(f'   TP: {tp}')
        logger.info(f'   Z-Score: {zscore:+.2f}')
        logger.info(f'   Confidence: {confidence:.0f}%')
        logger.info(f'   Reasoning: {reasoning}')
        
        # ===== SEND ORDER TO MT4 =====
        result = self._send_mt4_order(symbol, action, volume, price, sl, tp)
        
        if result.get('success'):
            # Add to active positions
            self.active_positions[symbol] = {
                'direction': action,
                'entry_price': price,
                'volume': volume,
                'sl': sl,
                'tp': tp,
                'zscore': zscore,
                'entry_time': datetime.now().isoformat()
            }
            
            # Save to signal service
            signal_service.add_signal(
                symbol=symbol,
                signal_type=action,
                confidence=confidence,
                price=price,
                z_score=zscore,
                reasoning=reasoning,
                source='REAL_TRADING',
                sl=sl,
                tp=tp
            )
            
            logger.info(f'✅ TRADE EXECUTED: {symbol} {action} {volume} @ {price}')
            return {
                'status': 'EXECUTED',
                'symbol': symbol,
                'action': action,
                'price': price,
                'volume': volume,
                'ticket': result.get('ticket', 0)
            }
        else:
            logger.error(f'❌ ORDER FAILED: {result.get("error", "Unknown error")}')
            return {'status': 'FAILED', 'reason': result.get('error', 'Unknown error')}
    
    def _send_mt4_order(self, symbol: str, action: str, volume: float,
                        price: float, sl: float, tp: float) -> Dict:
        """Send order to MT4 via command file"""
        try:
            # Build order command
            order = {
                "command": "ORDER",
                "symbol": symbol,
                "type": action,
                "volume": volume,
                "sl": sl,
                "tp": tp
            }
            
            # Write to command file
            with open(self.command_file, 'w') as f:
                json.dump(order, f)
            
            logger.info(f'📤 ORDER SENT to MT4: {symbol} {action} {volume} lots')
            logger.info(f'   File: {self.command_file}')
            
            # Wait for MT4 to process
            time.sleep(1)
            
            return {'success': True, 'ticket': int(time.time())}
            
        except Exception as e:
            logger.error(f'❌ Order failed: {e}')
            return {'success': False, 'error': str(e)}
    
    def monitor_positions(self):
        """Monitor active positions for SL/TP"""
        if not self.active_positions:
            return
        
        prices = self.dashboard.get_all_prices()
        if not prices:
            return
        
        for symbol in list(self.active_positions.keys()):
            pos = self.active_positions[symbol]
            current_price = prices.get(symbol, 0)
            
            if current_price <= 0:
                continue
            
            if pos['direction'] == 'BUY':
                if current_price <= pos['sl']:
                    self._close_position(symbol, current_price, 'STOP_LOSS')
                elif current_price >= pos['tp']:
                    self._close_position(symbol, current_price, 'TAKE_PROFIT')
            else:  # SELL
                if current_price >= pos['sl']:
                    self._close_position(symbol, current_price, 'STOP_LOSS')
                elif current_price <= pos['tp']:
                    self._close_position(symbol, current_price, 'TAKE_PROFIT')
    
    def _close_position(self, symbol: str, price: float, reason: str):
        """Close a position"""
        if symbol not in self.active_positions:
            return
        
        pos = self.active_positions.pop(symbol)
        
        # Calculate P&L
        if pos['direction'] == 'BUY':
            pnl = (price - pos['entry_price']) * pos['volume'] * 100000
        else:
            pnl = (pos['entry_price'] - price) * pos['volume'] * 100000
        
        was_win = pnl > 0
        self.risk_manager.update_risk_metrics(pnl, was_win)
        
        logger.info(f'🔚 POSITION CLOSED: {symbol}')
        logger.info(f'   P&L: ${pnl:.2f} ({reason})')
        logger.info(f'   Entry: {pos["entry_price"]} → Exit: {price}')
        logger.info(f'   Z-Score Entry: {pos.get("zscore", 0):+.2f}')
        
        self.trade_history.append({
            'symbol': symbol,
            'direction': pos['direction'],
            'entry_price': pos['entry_price'],
            'exit_price': price,
            'pnl': pnl,
            'reason': reason,
            'entry_zscore': pos.get('zscore', 0),
            'exit_time': datetime.now().isoformat()
        })
    
    def process_cycle(self) -> Dict:
        """Process one trading cycle"""
        self.cycle_count += 1
        
        # Fetch fresh data
        self.dashboard.fetch_prices()
        prices = self.dashboard.get_all_prices()
        
        # Update Dollar Engine
        self.dollar_engine.update_prices(prices)
        
        # Monitor positions
        self.monitor_positions()
        
        results = {
            'cycle': self.cycle_count,
            'timestamp': datetime.now().isoformat(),
            'signals': {},
            'trades': [],
            'active_positions': len(self.active_positions),
            'dashboard_connected': self.dashboard.is_connected(),
            'dollar_status': self.dollar_engine.get_status()
        }
        
        logger.info(f'\n🔄 CYCLE {self.cycle_count} - {datetime.now().strftime("%H:%M:%S")}')
        logger.info(f'   Dashboard: {"✅ Connected" if self.dashboard.is_connected() else "❌ Disconnected"}')
        
        dollar_status = results['dollar_status']
        logger.info(f'   💵 USD: {dollar_status["usd_direction"]} ({dollar_status["usd_strength"]:.1f})')
        logger.info(f'   Active Positions: {len(self.active_positions)}')
        
        # Process each symbol
        for symbol in self.all_symbols:
            if symbol in self.active_positions:
                continue
            
            price = self.dashboard.get_price(symbol)
            if price <= 0:
                continue
            
            # Get signal
            signal = self.get_signal(symbol, price)
            results['signals'][symbol] = signal
            
            action = signal.get('action', 'HOLD')
            confidence = signal.get('confidence', 0)
            zscore = signal.get('zscore', {}).get('z_score', 0)
            
            if action != 'HOLD' and confidence >= 50:
                logger.info(f'🎯 {symbol}: {action} ({confidence:.0f}%) | Z={zscore:+.2f}')
                logger.info(f'   {signal.get("reasoning", "")}')
                
                # Execute real trade
                trade_result = self.execute_trade(symbol, signal)
                results['trades'].append(trade_result)
                
                if trade_result.get('status') == 'EXECUTED':
                    logger.info(f'✅ REAL TRADE: {symbol} {action}')
            else:
                # Show progress every 5 cycles
                if self.cycle_count % 5 == 0 and abs(zscore) > 1.0:
                    logger.info(f'📊 {symbol}: Z={zscore:+.2f} | Price: {price:.5f}')
        
        # Summary
        risk_status = self.risk_manager.get_status()
        logger.info(f'\n📊 SUMMARY:')
        logger.info(f'   Active Positions: {len(self.active_positions)}')
        logger.info(f'   Daily P&L: ${risk_status["daily_pnl"]:.2f}')
        logger.info(f'   Trades Today: {risk_status["trades_today"]}')
        logger.info(f'   Cold Start: {"✅ Complete" if not risk_status["cold_start_active"] else "❄️ Active"}')
        
        return results
    
    def run(self):
        """Main loop"""
        self.is_running = True
        logger.info('🚀 Starting Advanced Trading Controller...')
        logger.info('   REAL TRADING ENABLED - Sending orders to MT4')
        
        try:
            while self.is_running:
                self.process_cycle()
                time.sleep(self.cycle_interval)
        except KeyboardInterrupt:
            self.stop()
    
    def stop(self):
        """Stop the controller"""
        self.is_running = False
        logger.info('✅ Stopped')


